---
import { themeConfig } from '~/.config'

const { colorsLight, colorsDark, fonts } = themeConfig.appearance

const fontHref
  = 'https://fonts.googleapis.com/css2?family=Noto+Sans+SC:wght@400;700&family=Noto+Serif+SC:wght@400;700&display=swap'

// Inlined so the first paint already has the theme's colours and fonts, even
// if the stylesheet is still in flight.
const criticalCss = `
:root{color-scheme:light;--color-primary:${colorsLight.primary};--color-background:${colorsLight.background}}
:root.dark{color-scheme:dark;--color-primary:${colorsDark.primary};--color-background:${colorsDark.background}}
html{background-color:var(--color-background);color:var(--color-primary);font-family:${fonts.ui}}
a{color:inherit;text-decoration:none}
`
---

<style is:inline set:html={criticalCss}></style>

{/*
  `media="print"` keeps the font request off the critical path, promoted to
  `all` once it lands. Importing it from `global.css` instead made the whole
  site stylesheet hostage to fonts.googleapis.com — unreachable on some
  networks, which left mobile visitors looking at unstyled markup.
*/}
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link rel="stylesheet" href={fontHref} media="print" onload="this.media='all'" />
<noscript><link rel="stylesheet" href={fontHref} /></noscript>
